---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, COMPANY, LOCATION, TIMEZONE, EMAIL, PHONE } from '../consts';
import GitHubWidget from '../components/GitHubWidget.astro';

const featuredProjects = (await getCollection('projects'))
	.filter(p => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

// Get current time in the specified timezone
const now = new Date();
const timeString = now.toLocaleTimeString('en-US', {
	hour: '2-digit',
	minute: '2-digit',
	hour12: false
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-8);">
			<!-- Hero Section -->
			<section style="margin-bottom: var(--space-8);">
				<h1>{SITE_TITLE}</h1>
				<p style="font-size: var(--font-size-h3); color: var(--color-text-secondary); margin-bottom: var(--space-2);">{SITE_DESCRIPTION}</p>
				<div style="display: flex; flex-wrap: wrap; gap: var(--space-3); color: var(--color-text-secondary); font-size: var(--font-size-body); margin-bottom: var(--space-3);">
					<div style="display: flex; align-items: center; gap: 0.5rem;">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.751.751 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0z"/>
						</svg>
						<span>{COMPANY}</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.5rem;">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
						</svg>
						<span>{LOCATION}</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.5rem;">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
							<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
						</svg>
						<span>{timeString} ({TIMEZONE})</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.5rem;">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
						</svg>
						<a href={`mailto:${EMAIL}`} style="color: var(--color-text-secondary); text-decoration: none;">{EMAIL}</a>
					</div>
					<div style="display: flex; align-items: center; gap: 0.5rem;">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
							<path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
						</svg>
						<a href={`tel:${PHONE}`} style="color: var(--color-text-secondary); text-decoration: none;">{PHONE}</a>
					</div>
				</div>
				<p style="font-size: var(--font-size-body-lg); color: var(--color-text-primary); max-width: 900px; margin-bottom: var(--space-4); line-height: 1.6;">
					Full-stack engineer and Lead Forward Deployed Engineer with deep expertise spanning the full software development lifecycle — from client discovery through production delivery. I lead end-to-end delivery of AI-powered products, working directly with clients on AI integration, full-stack engineering, and project ownership within a consulting environment.
				</p>
				<p style="font-size: var(--font-size-body-lg); color: var(--color-text-primary); max-width: 900px; margin-bottom: var(--space-4); line-height: 1.6;">
					Proven track record in defining and implementing end-to-end AI/ML and Generative AI application architectures, including Agentic AI frameworks (LangGraph, CrewAI, Llama Index), Retrieval-Augmented Generation (RAG) pipelines, and large-scale predictive modeling systems. Hands-on experience building secure, production-grade REST APIs and overseeing the deployment of advanced AI applications — from Agentic AI orchestration to complex GenAI/RAG systems in regulated enterprise environments.
				</p>
				<p style="font-size: var(--font-size-body-lg); color: var(--color-text-primary); max-width: 900px; margin-bottom: var(--space-4); line-height: 1.6;">
					Experienced across major cloud platforms (AWS, Azure, and GCP) as well as on-premise deployments, with a consistent focus on enterprise architecture, security, and scalability. Known for bridging strategic AI vision with practical engineering execution — leveraging agentic coding, autonomous feature generation, intelligent documentation, and AI-assisted code review to enforce quality and best practices at scale.
				</p>
				<div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
					<a href="/experience" class="btn-primary">
						View Experience
					</a>
					<a href="/projects" class="btn-secondary">
						See Projects
					</a>
					<a href="/resume" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(65,105,225,0.08); color: var(--color-accent); border-color: rgba(65,105,225,0.3);">
						<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
						Download Resume
					</a>
				</div>
			</section>

			<!-- Skills Highlights -->
			<section style="margin-bottom: var(--space-8);">
				<h2 style="margin-bottom: var(--space-4);">Core Expertise</h2>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
					<div class="card">
						<h3>AI & GenAI Architecture</h3>
						<p style="color: var(--color-text-secondary); margin-bottom: var(--space-3);">End-to-end AI/ML and Generative AI application architectures</p>
						<div style="display: flex; flex-wrap: wrap; gap: var(--space-1);">
							<span class="tag">LangGraph</span>
							<span class="tag">CrewAI</span>
							<span class="tag">Llama Index</span>
							<span class="tag">RAG</span>
							<span class="tag">Agentic AI</span>
						</div>
					</div>

					<div class="card">
						<h3>Full-Stack & Enterprise Architecture</h3>
						<p style="color: var(--color-text-secondary); margin-bottom: var(--space-3);">Scalable enterprise solutions and secure production-grade APIs</p>
						<div style="display: flex; flex-wrap: wrap; gap: var(--space-1);">
							<span class="tag">React</span>
							<span class="tag">Next.js</span>
							<span class="tag">TypeScript</span>
							<span class="tag">REST APIs</span>
							<span class="tag">NX Monorepo</span>
						</div>
					</div>

					<div class="card">
						<h3>Cloud & On-Premise Deployment</h3>
						<p style="color: var(--color-text-secondary); margin-bottom: var(--space-3);">Multi-cloud and on-premise deployments with enterprise security focus</p>
						<div style="display: flex; flex-wrap: wrap; gap: var(--space-1);">
							<span class="tag">AWS</span>
							<span class="tag">Azure</span>
							<span class="tag">GCP</span>
							<span class="tag">Terraform</span>
							<span class="tag">Docker</span>
						</div>
					</div>

					<div class="card">
						<h3>Client Delivery & Leadership</h3>
						<p style="color: var(--color-text-secondary); margin-bottom: var(--space-3);">End-to-end client delivery from discovery to production, technical leadership, and team mentoring</p>
						<div style="display: flex; flex-wrap: wrap; gap: var(--space-1);">
							<span class="tag">Client Consulting</span>
							<span class="tag">Solution Architecture</span>
							<span class="tag">Agile/SCRUM</span>
							<span class="tag">Mentoring</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Projects -->
			<section style="margin-bottom: var(--space-8);">
				<h2 style="margin-bottom: var(--space-4);">Featured Projects</h2>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
					{featuredProjects.map((project) => (
						<article class="card" style="transition: box-shadow 0.2s ease;">
							<h3 style="margin-bottom: var(--space-1);">
								<a href={`/projects/${project.id}`}>
									{project.data.title}
								</a>
							</h3>
							<p style="color: var(--color-text-secondary); margin-bottom: var(--space-3); font-size: 0.9rem;">{project.data.description}</p>
							<a href={`/projects/${project.id}`} style="font-weight: 500; font-size: 0.9rem;">
								Learn more →
							</a>
						</article>
					))}
				</div>
				<div style="margin-top: var(--space-4);">
					<a href="/projects" style="font-weight: 500;">
						View all projects →
					</a>
				</div>
			</section>

			<!-- GitHub Activity Widget -->
			<section style="margin-bottom: var(--space-8);">
				<GitHubWidget />
			</section>

			<!-- Contact Section -->
			<section class="card">
				<h2 style="margin-bottom: var(--space-2);">Get In Touch</h2>
				<p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">
					Interested in working together? Feel free to reach out!
				</p>
				<div style="display: flex; gap: var(--space-2); flex-wrap: wrap;">
					<a href="mailto:prabintp@gmail.com" class="btn-primary">
						Email Me
					</a>
					<a href="https://github.com/prabintp" target="_blank" class="btn-secondary" style="background: var(--color-secondary); color: var(--color-primary);">
						GitHub
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
