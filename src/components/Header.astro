---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>

		<div class="internal-links" id="nav-menu">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/experience">Experience</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/resume">Resume</HeaderLink>
		</div>

		<div class="right-controls">
			<ThemeToggle />
			<div class="social-links">
				<a href="https://www.linkedin.com/in/prabin-tp-47038932/" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">LinkedIn</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
						<path
							fill="currentColor"
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						/>
					</svg>
				</a>
				<a href="https://github.com/prabintp" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href="mailto:prabintp@gmail.com">
					<span class="sr-only">Email</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"
						></path></svg
					>
				</a>
			</div>

			<button class="menu-btn" id="menu-btn" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-menu">
				<svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="3" y1="6" x2="21" y2="6"/>
					<line x1="3" y1="12" x2="21" y2="12"/>
					<line x1="3" y1="18" x2="21" y2="18"/>
				</svg>
				<svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="18" y1="6" x2="6" y2="18"/>
					<line x1="6" y1="6" x2="18" y2="18"/>
				</svg>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 var(--space-2);
		background: var(--color-primary);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	h2 {
		margin: 0;
		font-size: var(--font-size-body-lg);
		font-weight: 700;
		color: var(--color-secondary);
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--color-secondary);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		max-width: 1200px;
		margin: 0 auto;
	}

	nav a {
		padding: var(--space-2) var(--space-1);
		color: var(--color-text-primary);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	nav a:hover {
		color: var(--color-accent);
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--color-accent);
		color: var(--color-accent);
	}

	.internal-links {
		display: flex;
		align-items: center;
	}

	.right-controls {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	.social-links {
		display: flex;
		gap: var(--space-1);
	}

	.social-links a {
		display: flex;
		align-items: center;
		color: var(--color-text-secondary);
		transition: color 0.2s ease;
	}

	.social-links a:hover {
		color: var(--color-accent);
	}

	/* Hamburger button — hidden on desktop */
	.menu-btn {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: var(--space-1);
		color: var(--color-text-secondary);
		align-items: center;
		border-radius: 6px;
		transition: color 0.2s ease, background-color 0.2s ease;
		line-height: 0;
	}

	.menu-btn:hover {
		color: var(--color-accent);
		background-color: rgba(65, 105, 225, 0.1);
	}

	#icon-close {
		display: none;
	}

	.menu-btn[aria-expanded="true"] #icon-menu {
		display: none;
	}

	.menu-btn[aria-expanded="true"] #icon-close {
		display: block;
	}

	/* ── Mobile ────────────────────────────────────────────── */
	@media (max-width: 720px) {
		.menu-btn {
			display: flex;
		}

		.social-links {
			display: none;
		}

		/* Nav links collapse behind hamburger */
		.internal-links {
			display: none;
			order: 3;
			width: 100%;
			flex-direction: column;
			align-items: stretch;
			border-top: 1px solid var(--color-border);
			padding: var(--space-1) 0;
		}

		.internal-links.open {
			display: flex;
		}

		/* Override desktop underline active style for vertical layout */
		.internal-links a {
			padding: 0.75rem var(--space-1);
			border-bottom: none;
			border-left: 3px solid transparent;
		}

		.internal-links a.active {
			border-bottom-color: transparent;
			border-left-color: var(--color-accent);
			background-color: rgba(65, 105, 225, 0.06);
		}
	}
</style>

<script>
	const btn = document.getElementById('menu-btn');
	const menu = document.getElementById('nav-menu');

	btn?.addEventListener('click', () => {
		const isOpen = menu!.classList.toggle('open');
		btn.setAttribute('aria-expanded', String(isOpen));
	});

	// Close menu when a nav link is clicked
	menu?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			menu.classList.remove('open');
			btn?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
